# Copy to .env (never commit .env). Environment variables always override this file.

# Database: PostgreSQL in Docker / production, SQLite file by default for quick local runs
DATABASE_URL=postgresql+psycopg://pharma:pharma@localhost:5432/pharma
# DATABASE_URL=sqlite:///storage/local.db

# Immutable raw snapshots (never deleted by the application)
RAW_STORAGE_DIR=storage/raw
# Operator-provided files (e.g. China VBP results): <dir>/<source_id>/*.csv
MANUAL_IMPORT_DIR=data/manual

# HTTP politeness
HTTP_TIMEOUT=60
HTTP_DELAY_SECONDS=0.5
HTTP_CONTACT=data-team@example.org

# UK dm+d: TRUD account + subscription to item 24 + licence acceptance on https://isd.digital.nhs.uk
TRUD_API_KEY=

# Ontario ODB XML extract override (the URL published on data.ontario.ca did not resolve in Oct 2026)
CA_ON_ODB_XML_URL=

LOG_LEVEL=INFO
# auto = readable text in a terminal, JSON lines otherwise (e.g. Docker/CI)
LOG_FORMAT=auto
PROGRESS_INTERVAL_SECONDS=5
PUBLISH_BATCH_SIZE=500
